# Required. Use your own resource origin and deployment names.
AZURE_ENDPOINT=
AZURE_LIVE_DEPLOYMENT=
AZURE_REASONING_DEPLOYMENT=

# Optional. Omit to use the tenant from your Azure CLI login.
# AZURE_TENANT_ID=

# Optional, backend only. Never use a VITE_ prefix for a credential.
WEB_IQ_API_KEY=

# Optional, max 500 characters. Names or addresses added to both model prompts so
# they can recognize them. Contents still have to be researched.
# DEMO_CONTEXT=

# Optional USD rates. Blank model rates remain unknown, not zero.
LIVE_USD_PER_MINUTE=
LIVE_MINIMUM_SECONDS=15
LIVE_ROUNDING_SECONDS=1
INPUT_USD_PER_MILLION=
CACHED_INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Public Web IQ Web Search rate, verified 2026-10-22. Override for your agreement.
WEB_USD_PER_THOUSAND=7
